# BlueLedger — Root Environment Configuration Template
# Copy this file to backend/.env and configure your local or deployment environment.
# NEVER commit populated .env files with real secrets or private keys to version control.

NODE_ENV=development
PORT=3001

# Database Connection (Render / Cloud: DATABASE_URL, Local / Docker: DB_HOST etc.)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/blue_carbon_mrv
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blue_carbon_mrv
DB_USER=postgres
DB_PASSWORD=

# Security & Authentication (minimum 32 characters in production)
JWT_SECRET=change-this-to-a-very-secure-random-32-char-string
BCRYPT_ROUNDS=12

# Allowed CORS Origins (comma-separated; no wildcard in production)
# CORS_ORIGINS=https://blueledger.vercel.app,http://localhost:3000

# Blockchain Network Configuration
ETH_RPC_URL=http://127.0.0.1:8545
CHAIN_MODE=local
ALLOW_LOCAL_CHAIN=1

# Evidence Storage & Pinning (none | kubo | pinata)
IPFS_PROVIDER=none
MAX_UPLOAD_MB=25

# Malware Scanning & Encryption
MALWARE_SCAN=optional
EVIDENCE_ENCRYPTION=off
