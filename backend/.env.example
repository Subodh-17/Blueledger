# Copy to backend/.env and adjust. Never commit the real .env or any private key.
NODE_ENV=development
PORT=3001

# Secret used to sign login tokens. REQUIRED in production (>= 32 random characters). In development an ephemeral one is generated if empty.
JWT_SECRET=
BCRYPT_ROUNDS=12

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blue_carbon_mrv
DB_USER=postgres
DB_PASSWORD=

# Blockchain network
ETH_RPC_URL=http://127.0.0.1:8545
# local = use the unlocked accounts of a local Hardhat node (development only; roles: [0] administrator, [1] verifier, [2] registrar)
# keys  = use service signing keys below (set them in the environment / a secret manager, never in git)
CHAIN_MODE=local
#CHAIN_ADMIN_PRIVATE_KEY=
#CHAIN_VERIFIER_PRIVATE_KEY=
#CHAIN_REGISTRAR_PRIVATE_KEY=
# Optional overrides (defaults: blockchain/deployments/localhost.json written by the deploy script)
#DEPLOYMENT_FILE=
#CONTRACT_ADDRESS=
RPC_TIMEOUT_MS=10000
TX_CONFIRM_TIMEOUT_MS=60000
# How often interrupted blockchain operations are resumed (0 disables the background reconciler)
RECONCILE_INTERVAL_MS=30000

# Evidence storage. Files are always kept in UPLOAD_DIR and hashed (SHA-256). IPFS pinning is optional:
#   none   - local storage only (default; no CID is recorded)
#   kubo   - pin through a Kubo HTTP API at IPFS_API_URL
#   pinata - pin through Pinata using PINATA_JWT
IPFS_PROVIDER=none
IPFS_API_URL=http://127.0.0.1:5001
#PINATA_JWT=
#UPLOAD_DIR=
MAX_UPLOAD_MB=25

# Map basemap tiles (empty value disables tiles; boundaries and markers are still drawn). Respect the tile provider's usage policy.
#MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
#MAP_ATTRIBUTION=© OpenStreetMap contributors

# Request limits per client address per minute (per process)
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_UPLOAD_MAX=60
# Set to 1 only when running behind a trusted reverse proxy so client addresses are read from X-Forwarded-For
TRUST_PROXY=0

# Reference accounts: used by `npm run db:seed` and offered on the sign-in page ONLY outside production.
REFERENCE_PASSWORD=Reference-Pass-2026
SHOW_REFERENCE_ACCOUNTS=1
# Comma separated browser origins allowed for CORS (empty = same-origin only; wildcards are rejected in production)
CORS_ORIGINS=
